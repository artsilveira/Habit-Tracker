# Exemplo de configuracao. O Java le variaveis de ambiente; nao carrega este arquivo.
APP_PORT=8080
APP_HOST=127.0.0.1
DB_URL=jdbc:postgresql://localhost:55432/habit_tracker
DB_USER=habit_tracker_app
DB_PASSWORD=troque-por-uma-senha-local
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Render: definir apenas DATABASE_URL com a URI de conexao direta do Neon.
# APP_ORIGIN usa RENDER_EXTERNAL_URL automaticamente, e o Docker define FRONTEND_DIR.
# DATABASE_URL tem prioridade sobre DB_URL, DB_USER e DB_PASSWORD.
